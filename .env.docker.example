# Copy to .env for local Docker Compose (never commit .env)
PROMPTOS_FRONTEND_PORT=3000
PROMPTOS_BACKEND_PORT=8080
PROMPTOS_MYSQL_PORT=3307
PROMPTOS_REDIS_PORT=6380
PROMPTOS_MYSQL_ROOT_PASSWORD=change-me-root-password
PROMPTOS_MYSQL_USER=promptos_app
PROMPTOS_MYSQL_PASSWORD=change-me-app-password
MYSQL_MIGRATION_USER=promptos_migrator
MYSQL_MIGRATION_PASSWORD=change-me-migration-password

# SMTP is required in production; leave empty for local development (devCode is returned).
PROMPTOS_SMTP_HOST=
PROMPTOS_SMTP_PORT=587
PROMPTOS_SMTP_USER=
PROMPTOS_SMTP_PASSWORD=
PROMPTOS_SMTP_FROM=

PROMPTOS_JWT_SECRET=change-me-use-a-long-random-string
PROMPTOS_JWT_EXPIRE_HOURS=72

PROMPTOS_UPLOAD_PROVIDER=local
PROMPTOS_UPLOAD_BASE_URL=http://localhost:8080
PROMPTOS_UPLOAD_MAX_MB=10
# GIF is disabled by default (animated GIFs are hard to validate safely); opt in only if needed
PROMPTOS_UPLOAD_ALLOW_GIF=false
# Comma-separated HTTPS domains allowed for remote prompt cover/images (default: only local /uploads/)
PROMPTOS_ALLOWED_IMAGE_DOMAINS=

# GitHub OAuth — use real values only in .env (not here)
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_OAUTH_ENABLED=false
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:3000

PROMPTOS_R2_ACCOUNT_ID=
# RustFS/S3-compatible endpoint, e.g. http://rustfs:9000. Leave empty for Cloudflare R2.
PROMPTOS_R2_ENDPOINT=
PROMPTOS_R2_ACCESS_KEY_ID=
PROMPTOS_R2_SECRET_ACCESS_KEY=
PROMPTOS_R2_BUCKET=
PROMPTOS_R2_PUBLIC_URL=
