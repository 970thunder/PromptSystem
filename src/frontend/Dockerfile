FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=/api/v1
ARG VITE_APP_TITLE=PromptOS
ARG VITE_ENABLE_PROMPT_API=true
ARG VITE_GITHUB_OAUTH_ENABLED=false
ARG VITE_OIDC_ENABLED=false
ARG VITE_IDENTITY_CENTER_BASE=https://id.isoumao.cn
ARG VITE_COMMUNITY_BASE=https://community.isoumao.cn
ARG VITE_NEBULA_BASE=https://nebula.isoumao.cn
ARG VITE_SKILL_ENABLED=false
ARG VITE_PLAYGROUND_ENABLED=false
ARG VITE_CREATOR_ACADEMY_ENABLED=false
ARG VITE_MARKETPLACE_ENABLED=false

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE
ENV VITE_ENABLE_PROMPT_API=$VITE_ENABLE_PROMPT_API
ENV VITE_GITHUB_OAUTH_ENABLED=$VITE_GITHUB_OAUTH_ENABLED
ENV VITE_OIDC_ENABLED=$VITE_OIDC_ENABLED
ENV VITE_IDENTITY_CENTER_BASE=$VITE_IDENTITY_CENTER_BASE
ENV VITE_COMMUNITY_BASE=$VITE_COMMUNITY_BASE
ENV VITE_NEBULA_BASE=$VITE_NEBULA_BASE
ENV VITE_SKILL_ENABLED=$VITE_SKILL_ENABLED
ENV VITE_PLAYGROUND_ENABLED=$VITE_PLAYGROUND_ENABLED
ENV VITE_CREATOR_ACADEMY_ENABLED=$VITE_CREATOR_ACADEMY_ENABLED
ENV VITE_MARKETPLACE_ENABLED=$VITE_MARKETPLACE_ENABLED

RUN npm run build

FROM nginx:1.29-alpine3.22

RUN apk upgrade --no-cache

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
